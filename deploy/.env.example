# Copy this file to deploy/.env and fill it in. deploy/.env is ignored by git; never commit it.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, digits and symbols.
SQL_SA_PASSWORD=
SQL_DATABASE=AlMotahedaErp
# Express is free (10 GB per database). Use Standard or Web only with a licence.
MSSQL_PID=Express
SQL_PORT=14333

# Token signing key. Generate once with:  openssl rand -base64 48
# Changing it signs everyone out.
JWT_SIGNING_KEY=

# First Executive, only for the first start with an empty database. Clear both afterwards.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# true = create/upgrade the tables when the API starts (trial runs). false on a real server.
APPLY_MIGRATIONS_ON_STARTUP=false
SWAGGER_ENABLED=false
COMPANY_TIME_ZONE=Africa/Cairo
API_PORT=8080

# Use a released image instead of building locally, for example:
# API_IMAGE=ghcr.io/ahmedgndy/almotaheda-erp-api:1.0.0
