<Project>
  <!--
    Central Package Management: every NuGet version is declared once, here.
    Project files reference packages without a version, so all modules
    always use the same version of a shared library.
    Transitive pinning lets a version listed here also override a package that only arrives as a
    dependency of another package (used below to lift a vulnerable version).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Only the Swashbuckle parts we use. The Swashbuckle.AspNetCore meta-package also adds a build step
    that starts the application after every build to export the OpenAPI file, which we don't need.
    Stay on 9.0.x for now: Swashbuckle 10 moves to Microsoft.OpenApi 2.x, which changes the
    namespaces used in ApiDocumentationSetup.cs.
  -->
  <ItemGroup Label="API documentation">
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerGen" Version="9.0.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.0.1" />
  </ItemGroup>

  <!--
    Database access. EF Core packages move together: keep them on the same version.
    Microsoft.Data.SqlClient is referenced directly only by the host's database health check.
  -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <!-- Reports: Excel (.xlsx) files built on the server. MIT licence. -->
  <ItemGroup Label="Reports">
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>

  <!--
    Security pin. Microsoft.Data.SqlClient brings System.Security.Cryptography.Pkcs 9.0.4, which has the
    advisories GHSA-846f-f764-76mx (high) and GHSA-2fmv-rv2c-59x7 (moderate); 9.0.21 is fixed. No SqlClient
    release brings a fixed version yet (7.1.1 still uses 9.0.18), so it is pinned here. Remove this pin once
    SqlClient depends on 9.0.21 or later.
    Important: this pin fixes what NuGet resolves, not what the API runs. The ASP.NET Core shared framework
    ships its own copy of this assembly, and a web app always loads that one. The advisories also cover
    10.0.0 to 10.0.12, so the machine that runs the API needs the .NET 10 runtime 10.0.13 or later.
  -->
  <ItemGroup Label="Security pins">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <!--
    Sign-in tokens. JwtBearer brings Microsoft.IdentityModel.* 8.0.1, which the Access module also uses
    to create tokens. Don't pin Microsoft.IdentityModel.* separately: mixed versions of those packages
    fail at runtime.
  -->
  <ItemGroup Label="Authentication">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
  </ItemGroup>

  <!--
    Testcontainers 4.14.0 and later bring SSH.NET 2026.0.0, which fixes GHSA-q939-rpr3-3284 and
    GHSA-mggc-4xg6-vcxf (4.6.0 brought SSH.NET 2024.2.0). Test projects only; nothing here ships.
  -->
  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>
</Project>
