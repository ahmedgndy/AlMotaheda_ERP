<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Projects module: construction projects, who is on each project, and who may open which project.
    Allowed references: BuildingBlocks and other modules' *.Contracts projects only.
    Everything except ProjectsModule stays internal.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module owns its tables, so it owns its EF Core context and migrations (schema "projects"). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design-time only: lets `dotnet ef` create migrations for this module. Not shipped with the application. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\AlMotaheda.BuildingBlocks\AlMotaheda.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\AlMotaheda.BuildingBlocks.Data\AlMotaheda.BuildingBlocks.Data.csproj" />
    <!-- User names and roles, and the database check that the caller is still an active Executive. -->
    <ProjectReference Include="..\..\Access\AlMotaheda.Modules.Access.Contracts\AlMotaheda.Modules.Access.Contracts.csproj" />
    <!-- The module implements its own contracts (Integration folder) and consumes the cost figures other modules report through them. -->
    <ProjectReference Include="..\AlMotaheda.Modules.Projects.Contracts\AlMotaheda.Modules.Projects.Contracts.csproj" />
    <!-- Supplier payments go through Finance payment requests; Finance writes them back here once paid. -->
    <ProjectReference Include="..\..\Finance\AlMotaheda.Modules.Finance.Contracts\AlMotaheda.Modules.Finance.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlMotaheda.Modules.Projects.Tests" />
    <!-- The other modules' database tests create projects and items through the Projects test helpers. -->
    <InternalsVisibleTo Include="AlMotaheda.Modules.Workforce.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Subcontractors.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Fleet.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Archive.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Platform.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Finance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared input rules (ValidationErrors, Input, NumberInput, Paging, RowVersions) and SQL Server helpers
         (SqlAppLock, SqlViolations, SqlList, ModuleMigrations), used by most slices. -->
    <Using Include="AlMotaheda.BuildingBlocks.Validation" />
    <Using Include="AlMotaheda.BuildingBlocks.Data" />
  </ItemGroup>

</Project>
