<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Access module: sign-in, users, roles and permissions.
    Allowed references: BuildingBlocks and other modules' *.Contracts projects only.
    Everything except AccessModule stays internal.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module owns its tables, so it owns its EF Core context and migrations (see docs/architecture.md, rule 7). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design-time only: lets `dotnet ef` create migrations for this module. Not shipped with the application. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The module issues the access tokens, so it also tells the host how to validate them. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\AlMotaheda.BuildingBlocks\AlMotaheda.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\AlMotaheda.BuildingBlocks.Data\AlMotaheda.BuildingBlocks.Data.csproj" />
    <!-- The module implements its own contracts (Integration folder) for other modules to use. -->
    <ProjectReference Include="..\AlMotaheda.Modules.Access.Contracts\AlMotaheda.Modules.Access.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlMotaheda.Modules.Access.Tests" />
    <!-- The Projects tests sign in through the real Access endpoints and reuse the Access test helpers. -->
    <InternalsVisibleTo Include="AlMotaheda.Modules.Projects.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Workforce.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Subcontractors.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Fleet.Tests" />
    <InternalsVisibleTo Include="AlMotaheda.Modules.Archive.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared input rules (ValidationErrors, Input, NumberInput, Paging, RowVersions) and SQL Server helpers
         (SqlAppLock, SqlViolations, SqlList, ModuleMigrations), used by most slices. -->
    <Using Include="AlMotaheda.BuildingBlocks.Validation" />
    <Using Include="AlMotaheda.BuildingBlocks.Data" />
  </ItemGroup>

</Project>
