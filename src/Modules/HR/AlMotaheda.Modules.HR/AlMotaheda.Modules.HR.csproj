<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HR module: departments, employees (office staff, engineers, staff), their documents, salary structures, monthly
    payroll inputs and the monthly salary sheet. Salaries are paid through Finance payment requests.
    Daily-paid workers and guards stay in the Workforce module.
    Allowed references: BuildingBlocks and other modules' *.Contracts projects only.
    Everything except HrModule stays internal.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module owns its tables, so it owns its EF Core context and migrations (schema "hr"). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design-time only: lets `dotnet ef` create migrations for this module. Not shipped with the application. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\AlMotaheda.BuildingBlocks\AlMotaheda.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\AlMotaheda.BuildingBlocks.Data\AlMotaheda.BuildingBlocks.Data.csproj" />
    <!-- User names (who prepared and reviewed a sheet), and linking an employee to a sign-in account. -->
    <ProjectReference Include="..\..\Access\AlMotaheda.Modules.Access.Contracts\AlMotaheda.Modules.Access.Contracts.csproj" />
    <!-- Salary sheets are paid through Finance payment requests; Finance marks the sheet paid once the money left. -->
    <ProjectReference Include="..\..\Finance\AlMotaheda.Modules.Finance.Contracts\AlMotaheda.Modules.Finance.Contracts.csproj" />
    <!-- Salaries charged to projects (docs/cost-flow §2.6): project lookups and the project cost contracts. -->
    <ProjectReference Include="..\..\Projects\AlMotaheda.Modules.Projects.Contracts\AlMotaheda.Modules.Projects.Contracts.csproj" />
    <!-- The module's reports (IReportSource). -->
    <ProjectReference Include="..\..\Reports\AlMotaheda.Modules.Reports.Contracts\AlMotaheda.Modules.Reports.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlMotaheda.Modules.HR.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AlMotaheda.BuildingBlocks.Validation" />
    <Using Include="AlMotaheda.BuildingBlocks.Data" />
  </ItemGroup>

</Project>
