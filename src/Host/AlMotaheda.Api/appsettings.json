{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ApiDocumentation": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Access": {
    "Tokens": {
      "Issuer": "AlMotaheda.Api",
      "Audience": "AlMotaheda.Erp"
    }
  },
  "Projects": {
    "TimeZone": "Africa/Cairo",
    "PriceCheckPolicy": "ExecutiveApproval",
    "CustodyBalanceCheck": "Warn"
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    },
    "TokenRefresh": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
