{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "ApiDocumentation": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Access": {
    "Tokens": {
      "Issuer": "AlMotaheda.Api",
      "Audience": "AlMotaheda.Erp"
    }
  },
  "Projects": {
    "TimeZone": "Africa/Cairo",
    "PriceCheckPolicy": "ExecutiveApproval",
    "CustodyBalanceCheck": "Warn"
  },
  "Finance": {
    "CustodyPeriodCarryForward": "CarryForward"
  },
  "Fleet": {
    "ClaimExecutiveApprovalAbove": 0,
    "ImplausibleDistanceKmPerDay": 1000,
    "MaxClaimAgeDays": 60,
    "ImageMaxMegabytes": 15,
    "DocumentMaxMegabytes": 20,
    "Gps": {
      "Provider": "None",
      "RetentionDays": 90
    }
  },
  "Office": {
    "RoutineApprovalLimit": 5000,
    "ReservePendingExpenses": true,
    "PriceCategories": [ "Internet", "OfficeExpenses", "Maintenance" ],
    "ImageMaxMegabytes": 15,
    "DocumentMaxMegabytes": 20,
    "MaxExpenseAgeDays": 60
  },
  "RateLimiting": {
    "Authentication": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    },
    "TokenRefresh": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
