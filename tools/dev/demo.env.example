# AlMotaheda ERP - local demo environment (development only).
# Copy to .local/demo.env (git-ignored) and fill in the <...> values. See docs/local-demo.md.
# Quote every value: some contain spaces or semicolons.
ASPNETCORE_ENVIRONMENT='Development'
ASPNETCORE_URLS='https://localhost:7200'
# Must be a SQL Server on this machine and a database whose name ends in _Demo (the scripts refuse anything else).
ConnectionStrings__Erp='Server=localhost,1433;Database=AlMotahedaErp_v2_Demo;User Id=sa;Password=<sa-password>;TrustServerCertificate=true'
# A random key of at least 32 bytes, for example: openssl rand -base64 48
Access__Tokens__SigningKey='<random-signing-key>'
Database__ApplyMigrationsOnStartup='true'
ApiDocumentation__Enabled='true'
# The first Executive the API creates on an empty database. Choose a password; the seed signs in with it once.
Access__Bootstrap__Email='bootstrap.executive@almotaheda.test'
Access__Bootstrap__Password='<bootstrap-password>'
Access__Bootstrap__NameAr='المدير التنفيذي (تهيئة)'
Access__Bootstrap__NameEn='Bootstrap Executive'
# Uploaded files (absolute paths). Use a new folder whenever you use a new database.
Archive__Storage__RootPath='<repo>/.local/storage-v2/archive'
Fleet__Storage__RootPath='<repo>/.local/storage-v2/fleet'
Hr__Storage__RootPath='<repo>/.local/storage-v2/hr'
Office__Storage__RootPath='<repo>/.local/storage-v2/office'
